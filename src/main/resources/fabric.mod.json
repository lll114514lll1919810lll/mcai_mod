{
  "schemaVersion": 1,
  "id": "mcai",
  "version": "${version}",
  "name": "MCAI - Minecraft AI 助手",
  "description": "AI 自动管理 Minecraft 服务器：智能对话、指令执行、行为审查、知识库搜索。支持 DeepSeek 等 OpenAI 兼容 API。",
  "authors": [
    "MCAI Team"
  ],
  "contact": {
    "homepage": "https://github.com/lll114514lll1919810lll/mcai_mod",
    "sources": "https://github.com/lll114514lll1919810lll/mcai_mod",
    "issues": "https://github.com/lll114514lll1919810lll/mcai_mod/issues"
  },
  "license": "MIT",
  "icon": "assets/mcai/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.mcai.MCAIMod"
    ],
    "modmenu": [
      "com.example.mcai.client.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": ">=1.21",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
